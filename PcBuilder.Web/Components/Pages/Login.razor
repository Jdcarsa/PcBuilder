@* Pages/Login.razor *@
@page "/login"
@using PcBuilder.Application.DTOs
@using PcBuilder.Web.Components.Atoms
@using PcBuilder.Web.Services
@inject ApiClient Api
@inject SesionService Sesion
@inject NavigationManager Nav

<PageTitle>Ingresar — PcBuilder</PageTitle>

<div class="container py-5" style="max-width:440px">
    <div class="text-center mb-4">
        <a href="/" class="text-decoration-none">
            <h4 class="fw-black text-uppercase">PC<span class="text-naranja">Builder</span></h4>
        </a>
        <p class="text-muted small">@(_modoRegistro ? "Crea tu cuenta" : "Ingresa a tu cuenta")</p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <Alerta Mensaje="@_error" Tipo="danger" />
            <Alerta Mensaje="@_exito" Tipo="success" />

            @if (!_modoRegistro)
            {
                <AppInput Label="Email" Type="email" Placeholder="tu@email.com"
                          Valor="@_email" ValorChanged="v => _email = v" />
                <AppInput Label="Contraseña" Type="password" Placeholder="••••••••"
                          Valor="@_password" ValorChanged="v => _password = v" />

                <AppButton Variante="naranja" Clase="w-100 mt-2"
                           OnClick="HandleLogin" Cargando="@_cargando">
                    Ingresar
                </AppButton>

                <p class="text-center small text-muted mt-3 mb-0">
                    ¿No tienes cuenta?
                    <button class="btn btn-link btn-sm p-0 text-naranja"
                            @onclick="() => { _modoRegistro = true; _error = _exito = string.Empty; }">
                        Regístrate
                    </button>
                </p>
            }
            else
            {
                <div class="row g-2">
                    <div class="col-6">
                        <AppInput Label="Nombre" Placeholder="Juan"
                                  Valor="@_nombre" ValorChanged="v => _nombre = v" />
                    </div>
                    <div class="col-6">
                        <AppInput Label="Apellido" Placeholder="Pérez"
                                  Valor="@_apellido" ValorChanged="v => _apellido = v" />
                    </div>
                </div>
                <AppInput Label="Email" Type="email" Placeholder="tu@email.com"
                          Valor="@_email" ValorChanged="v => _email = v" />
                <AppInput Label="Contraseña" Type="password" Placeholder="Mínimo 8 caracteres"
                          Valor="@_password" ValorChanged="v => _password = v" />

                <AppButton Variante="naranja" Clase="w-100 mt-2"
                           OnClick="HandleRegistro" Cargando="@_cargando">
                    Crear cuenta
                </AppButton>

                <p class="text-center small text-muted mt-3 mb-0">
                    ¿Ya tienes cuenta?
                    <button class="btn btn-link btn-sm p-0 text-naranja"
                            @onclick="() => { _modoRegistro = false; _error = _exito = string.Empty; }">
                        Ingresar
                    </button>
                </p>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private bool _modoRegistro;
    private bool _cargando;
    private string _email    = string.Empty;
    private string _password = string.Empty;
    private string _nombre   = string.Empty;
    private string _apellido = string.Empty;
    private string _error    = string.Empty;
    private string _exito    = string.Empty;

    protected override void OnInitialized()
    {
        if (Sesion.EstaAutenticado)
            Nav.NavigateTo(ReturnUrl ?? "/");
    }

    private async Task HandleLogin()
    {
        _error = string.Empty;
        _cargando = true;
        try
        {
            var resultado = await Api.PostAsync<LoginResponse>(
                "/api/auth/login",
                new LoginRequest(_email, _password));

            Sesion.IniciarSesion(resultado!);
            Nav.NavigateTo(ReturnUrl ?? "/");
        }
        catch (Exception ex) { _error = "Credenciales inválidas."; }
        finally { _cargando = false; }
    }

    private async Task HandleRegistro()
    {
        _error = string.Empty;
        _cargando = true;
        try
        {
            await Api.PostAsync<UsuarioResponse>(
                "/api/auth/registro",
                new RegistrarUsuarioRequest(_nombre, _apellido, _email, _password));

            _exito = "Cuenta creada. Ahora puedes ingresar.";
            _modoRegistro = false;
            _password = string.Empty;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _cargando = false; }
    }
}
