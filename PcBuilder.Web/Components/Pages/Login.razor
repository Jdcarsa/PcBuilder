@* Pages/Login.razor *@
@page "/login"
@layout EmptyLayout
@using PcBuilder.Application.DTOs
@using PcBuilder.Web.Components.Atoms
@using PcBuilder.Web.Components.Layout
@using PcBuilder.Web.Services
@inject ApiClient Api
@inject SesionService Sesion
@inject NavigationManager Nav

<PageTitle>Ingresar — PcBuilder</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="text-center mb-4">
            <a href="/" class="text-decoration-none">
                <h4 class="fw-black text-uppercase">PC<span class="text-naranja">Builder</span></h4>
            </a>
            <p class="text-muted small mt-1 mb-0">
                @(_modoRegistro ? "Crea tu cuenta" : "Ingresa a tu cuenta")
            </p>
        </div>

        <Alerta Mensaje="@_error" Tipo="danger" />
        <Alerta Mensaje="@_exito" Tipo="success" />

        @if (!_modoRegistro)
        {
            <AppInput Label="Email" Type="email" Placeholder="tu@email.com"
                      Valor="@_email" ValorChanged="v => _email = v" />
            <AppInput Label="Contraseña" Type="password" Placeholder="••••••••"
                      Valor="@_password" ValorChanged="v => _password = v" />

            <AppButton Variante="naranja" Clase="w-100 mt-1"
                       OnClick="HandleLogin" Cargando="@_cargando">
                Ingresar
            </AppButton>

            <div class="rounded border p-3 mb-3 mt-3" style="background:#fafafa">
                <p class="text-muted text-uppercase mb-2" style="font-size:.6rem;letter-spacing:1.5px">
                    <i class="bi bi-info-circle me-1"></i>Cuentas de prueba
                </p>
                <p class="mb-1 small">
                    <code>admin@pcbuilder.com</code> / <code>Admin123!</code>
                </p>
                <p class="mb-0 small">
                    <code>juan@correo.com</code> / <code>Cliente123!</code>
                </p>
            </div>
            <p class="text-center small text-muted mt-3 mb-0">
                ¿No tienes cuenta?
                <button class="btn btn-link btn-sm p-0 text-naranja"
                        @onclick="() => { _modoRegistro = true; _error = _exito = string.Empty; }">
                    Regístrate
                </button>
            </p>
        }
        else
        {
            <div class="row g-2">
                <div class="col-6">
                    <AppInput Label="Nombre" Placeholder="Juan"
                              Valor="@_nombre" ValorChanged="v => _nombre = v" />
                </div>
                <div class="col-6">
                    <AppInput Label="Apellido" Placeholder="Pérez"
                              Valor="@_apellido" ValorChanged="v => _apellido = v" />
                </div>
            </div>
            <AppInput Label="Email" Type="email" Placeholder="example@email.com"
                      Valor="@_email" ValorChanged="v => _email = v" />
            <AppInput Label="Contraseña" Type="password" Placeholder="Mínimo 8 caracteres"
                      Valor="@_password" ValorChanged="v => _password = v" />

            <AppButton Variante="naranja" Clase="w-100 mt-1"
                       OnClick="HandleRegistro" Cargando="@_cargando">
                Crear cuenta
            </AppButton>

            <p class="text-center small text-muted mt-3 mb-0">
                ¿Ya tienes cuenta?
                <button class="btn btn-link btn-sm p-0 text-naranja"
                        @onclick="() => { _modoRegistro = false; _error = _exito = string.Empty; }">
                    Ingresar
                </button>
            </p>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private bool _modoRegistro;
    private bool _cargando;
    private string _email    = string.Empty;
    private string _password = string.Empty;
    private string _nombre   = string.Empty;
    private string _apellido = string.Empty;
    private string _error    = string.Empty;
    private string _exito    = string.Empty;

    protected override void OnInitialized()
    {
        if (Sesion.EstaAutenticado)
            Nav.NavigateTo(ReturnUrl ?? "/");
    }

    private async Task HandleLogin()
    {
        _error = string.Empty;
        _cargando = true;
        try
        {
            var resultado = await Api.PostAsync<LoginResponse>(
                "/api/auth/login",
                new LoginRequest(_email, _password));

            await Sesion.IniciarSesionAsync(resultado!);
            var destino = !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl != "/" ? ReturnUrl : Sesion.EsAdministrador ? "/admin" : "/";
            Nav.NavigateTo(destino);
        }
        catch { _error = "Credenciales inválidas."; }
        finally { _cargando = false; }
    }

    private async Task HandleRegistro()
    {
        _error = string.Empty;
        _cargando = true;
        try
        {
            await Api.PostAsync<UsuarioResponse>(
                "/api/auth/registro",
                new RegistrarUsuarioRequest(_nombre, _apellido, _email, _password));

            _exito = "Cuenta creada. Ahora puedes ingresar.";
            _modoRegistro = false;
            _password = string.Empty;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _cargando = false; }
    }
}
