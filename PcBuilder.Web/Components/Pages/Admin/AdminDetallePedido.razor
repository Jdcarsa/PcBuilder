@* Pages/Admin/AdminDetallePedido.razor *@
@page "/admin/pedidos/{Id:long}"
@layout AdminLayout
@using PcBuilder.Application.DTOs
@using PcBuilder.Web.Components.Atoms
@using PcBuilder.Web.Components.Layout
@using PcBuilder.Web.Services
@inject ApiClient Api

<PageTitle>Pedido — Admin PcBuilder</PageTitle>



<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/admin/pedidos" class="btn btn-link btn-sm text-muted p-0">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

@if (_cargando)
{
    <Spinner />
}
else if (_pedido is null)
{
    <Alerta Mensaje="Pedido no encontrado." Tipo="danger" />
}
else
{
    <div class="admin-page-header">
        <div>
            <h4 class="admin-page-title mb-0">@_pedido.NumeroPedido</h4>
            <small class="text-muted">@_pedido.CreadoEn.ToString("dd 'de' MMMM yyyy · HH:mm", _cultura)</small>
        </div>
        <span class="badge @BadgeEstado(_pedido.Estado) fs-6 px-3 py-2">@_pedido.Estado</span>
    </div>

    <Alerta Mensaje="@_exito" Tipo="success" />
    <Alerta Mensaje="@_error" Tipo="danger" />

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white small fw-bold text-uppercase letter-spacing-1">
                    <i class="bi bi-box-seam me-2 text-naranja"></i>Productos
                </div>
                <div class="card-body p-0">
                    @foreach (var item in _pedido.Items)
                    {
                        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                            <div>
                                <p class="mb-0 small fw-semibold">@item.NombreComponente</p>
                                <small class="text-muted">
                                    @item.PrecioUnitario.ToString("C0", _cultura) × @item.Cantidad
                                </small>
                            </div>
                            <span class="fw-bold text-naranja">
                                @item.Subtotal.ToString("C0", _cultura)
                            </span>
                        </div>
                    }
                    <div class="d-flex justify-content-between px-3 py-3">
                        <span class="fw-bold">Total</span>
                        <span class="fw-black text-naranja fs-5">
                            @_pedido.Total.ToString("C0", _cultura)
                        </span>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white small fw-bold text-uppercase letter-spacing-1">
                    <i class="bi bi-geo-alt me-2 text-naranja"></i>Envío
                </div>
                <div class="card-body">
                    <p class="small mb-1">@_pedido.DireccionEnvio</p>
                    @if (_pedido.NumeroGuia is not null)
                    {
                        <p class="small mb-1">
                            <i class="bi bi-truck me-1 text-naranja"></i>
                            Guía: <strong>@_pedido.NumeroGuia</strong>
                        </p>
                    }
                    @if (_pedido.NotasCliente is not null)
                    {
                        <p class="small text-muted mb-0">Nota: @_pedido.NotasCliente</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white small fw-bold text-uppercase letter-spacing-1">
                    <i class="bi bi-arrow-repeat me-2 text-naranja"></i>Cambiar estado
                </div>
                <div class="card-body d-flex flex-column gap-2">
                    @if (_pedido.Estado == "Confirmado")
                    {
                        <AppButton Variante="warning" Clase="w-100"
                                   OnClick="IniciarProcesamiento" Cargando="@_procesando">
                            <i class="bi bi-gear me-2"></i>Iniciar procesamiento
                        </AppButton>
                    }

                    @if (_pedido.Estado == "EnProcesamiento")
                    {
                        <div class="mb-2">
                            <AppInput Label="Número de guía" Placeholder="TRK-000000"
                                      Valor="@_guia" ValorChanged="v => _guia = v" />
                        </div>
                        <AppButton Variante="info" Clase="w-100"
                                   OnClick="Enviar" Cargando="@_procesando">
                            <i class="bi bi-truck me-2"></i>Marcar como enviado
                        </AppButton>
                    }

                    @if (_pedido.Estado == "Enviado")
                    {
                        <AppButton Variante="success" Clase="w-100"
                                   OnClick="MarcarEntregado" Cargando="@_procesando">
                            <i class="bi bi-check2-circle me-2"></i>Marcar como entregado
                        </AppButton>
                    }

                    @if (_pedido.Estado is not ("Entregado" or "Cancelado"))
                    {
                        <AppButton Variante="outline-danger" Clase="w-100"
                                   OnClick="Cancelar" Cargando="@_procesando">
                            <i class="bi bi-x-circle me-2"></i>Cancelar pedido
                        </AppButton>
                    }

                    @if (_pedido.Estado is "Entregado" or "Cancelado")
                    {
                        <p class="text-muted small text-center mb-0">
                            Este pedido no puede modificarse.
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long Id { get; set; }

    private PedidoResponse? _pedido;
    private bool _cargando = true;
    private bool _procesando;
    private string _guia = string.Empty;
    private string _error = string.Empty;
    private string _exito = string.Empty;

    private static readonly System.Globalization.CultureInfo _cultura = new("es-CO");

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        _cargando = true;
        try { _pedido = await Api.GetAsync<PedidoResponse>($"/api/pedidos/{Id}"); }
        catch { _pedido = null; }
        finally { _cargando = false; }
    }

    private async Task IniciarProcesamiento() => await CambiarEstado($"/api/pedidos/{Id}/procesar");
    private async Task MarcarEntregado()      => await CambiarEstado($"/api/pedidos/{Id}/entregar");
    private async Task Cancelar()             => await CambiarEstado($"/api/pedidos/{Id}/cancelar");

    private async Task Enviar()
    {
        if (string.IsNullOrWhiteSpace(_guia))
        {
            _error = "Ingrese el número de guía.";
            return;
        }
        _error = string.Empty;
        _procesando = true;
        try
        {
            _pedido = await Api.PostAsync<PedidoResponse>(
                $"/api/pedidos/{Id}/enviar",
                new EnviarPedidoRequest(_guia));
            _exito = "Estado actualizado.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _procesando = false; }
    }

    private async Task CambiarEstado(string url)
    {
        _error = _exito = string.Empty;
        _procesando = true;
        try
        {
            _pedido = await Api.PostAsync<PedidoResponse>(url);
            _exito = "Estado actualizado correctamente.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _procesando = false; }
    }

    private static string BadgeEstado(string estado) => estado switch
    {
        "Confirmado"      => "bg-primary",
        "EnProcesamiento" => "bg-warning text-dark",
        "Enviado"         => "bg-info text-dark",
        "Entregado"       => "bg-success",
        "Cancelado"       => "bg-danger",
        _                 => "bg-secondary"
    };
}
