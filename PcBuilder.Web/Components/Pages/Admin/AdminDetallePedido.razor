@* Pages/Admin/AdminDetallePedido.razor *@
@page "/admin/pedidos/{Id:long}"
@layout AdminLayout
@using PcBuilder.Application.DTOs
@using PcBuilder.Web.Components.Atoms
@using PcBuilder.Web.Components.Layout
@using PcBuilder.Web.Helpers
@using PcBuilder.Web.Services
@inject ApiClient Api

<PageTitle>Pedido — Admin PcBuilder</PageTitle>

<a href="/admin/pedidos" class="d-inline-flex align-items-center gap-2 text-muted text-decoration-none small mb-3">
    <i class="bi bi-arrow-left"></i> Volver a pedidos
</a>

@if (_cargando)
{
    <Spinner />
}
else if (_pedido is null)
{
    <Alerta Mensaje="Pedido no encontrado." Tipo="danger" />
}
else
{
    <div class="card border-0 shadow-sm overflow-hidden">

        @* Header *@
        <div class="card-header bg-white d-flex align-items-center justify-content-between py-3 px-4">
            <div>
                <p class="fw-semibold mb-0">@_pedido.NumeroPedido</p>
                <small class="text-muted">
                    @_pedido.CreadoEn.ToString("dd 'de' MMMM 'de' yyyy · HH:mm", _cultura)
                </small>
            </div>
            <span class="badge @PedidoUi.Badge(_pedido.Estado) d-flex align-items-center gap-1 px-3 py-2">
                <i class="bi @PedidoUi.Icono(_pedido.Estado)"></i>
                @_pedido.Estado
            </span>
        </div>

        @* Timeline *@
        @if (_pedido.Estado != "Cancelado" && _pedido.Estado != "Borrador")
        {
            <div class="px-4 py-3 border-bottom d-flex align-items-center">
                @{
                    var pasos = new[] { "Confirmado", "EnProcesamiento", "Enviado", "Entregado" };
                    var indexActual = Array.IndexOf(pasos, _pedido.Estado);
                }
                @for (int i = 0; i < pasos.Length; i++)
                {
                    var paso = pasos[i];
                    var idx = i;
                    var hecho = idx <= indexActual;
                    var actual = idx == indexActual;

                    <div class="d-flex flex-column align-items-center" style="flex:1;min-width:60px">
                        <div class="rounded-circle d-flex align-items-center justify-content-center mb-1
                                    @(actual ? "bg-primary text-white" : hecho ? "bg-success text-white" : "bg-light text-muted")"
                             style="width:28px;height:28px;font-size:13px;border:1px solid @(actual ? "transparent" : hecho ? "transparent" : "#dee2e6")">
                            <i class="bi @(hecho && !actual ? "bi-check-lg" : PedidoUi.Icono(paso))"></i>
                        </div>
                        <span class="text-center @(actual ? "fw-semibold text-primary" : hecho ? "text-success" : "text-muted")"
                              style="font-size:10px;line-height:1.3">
                            @PedidoUi.NombrePaso(paso)
                        </span>
                    </div>

                    @if (i < pasos.Length - 1)
                    {
                        <div style="flex:1;height:1px;background:@(idx < indexActual ? "#198754" : "#dee2e6");opacity:.5;margin-bottom:18px"></div>
                    }
                }
            </div>
        }

        <div class="row g-0">
            @* Izquierda: productos + envío *@
            <div class="col-lg-8 border-end">

                @* Productos *@
                <div class="px-4 py-3 border-bottom">
                    <p class="small fw-semibold text-uppercase text-muted letter-spacing-1 mb-3">
                        <i class="bi bi-box-seam me-2 text-naranja"></i>Productos
                    </p>
                    @foreach (var item in _pedido.Items)
                    {
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                            <div>
                                <p class="mb-0 small fw-semibold">@item.NombreComponente</p>
                                <small class="text-muted">
                                    @item.PrecioUnitario.ToString("C0", _cultura) × @item.Cantidad
                                </small>
                            </div>
                            <span class="small fw-semibold text-naranja">
                                @item.Subtotal.ToString("C0", _cultura)
                            </span>
                        </div>
                    }
                    <div class="d-flex justify-content-between align-items-center pt-3">
                        <span class="fw-semibold">Total</span>
                        <span class="fs-5 fw-black text-naranja">
                            @_pedido.Total.ToString("C0", _cultura)
                        </span>
                    </div>
                </div>

                @* Envío *@
                <div class="px-4 py-3">
                    <p class="small fw-semibold text-uppercase text-muted letter-spacing-1 mb-3">
                        <i class="bi bi-geo-alt me-2 text-naranja"></i>Envío
                    </p>
                    <div class="row g-2">
                        <div class="col-12">
                            <p class="x-small text-muted mb-1">Dirección</p>
                            <p class="small fw-semibold mb-0">@_pedido.DireccionEnvio</p>
                        </div>
                        @if (_pedido.NotasCliente is not null)
                        {
                            <div class="col-12">
                                <p class="x-small text-muted mb-1">Nota del cliente</p>
                                <p class="small mb-0">@_pedido.NotasCliente</p>
                            </div>
                        }
                        @if (_pedido.NumeroGuia is not null)
                        {
                            <div class="col-12">
                                <div class="d-inline-flex align-items-center gap-2 bg-light rounded px-3 py-2 small">
                                    <i class="bi bi-truck text-muted"></i>
                                    Guía: <strong>@_pedido.NumeroGuia</strong>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Derecha: cambiar estado *@
            <div class="col-lg-4">
                <div class="px-4 py-3">
                    <p class="small fw-semibold text-uppercase text-muted letter-spacing-1 mb-3">
                        <i class="bi bi-arrow-repeat me-2 text-naranja"></i>Cambiar estado
                    </p>

                    <Alerta Mensaje="@_exito" Tipo="success" />
                    <Alerta Mensaje="@_error" Tipo="danger" />

                    <div class="d-flex flex-column gap-2">
                        @if (_pedido.Estado == "Confirmado")
                        {
                            <AppButton Variante="warning" Clase="w-100"
                                       OnClick="IniciarProcesamiento" Cargando="@_procesando">
                                <i class="bi bi-gear me-2"></i>Iniciar procesamiento
                            </AppButton>
                        }

                        @if (_pedido.Estado == "EnProcesamiento")
                        {
                            <AppInput Label="Número de guía" Placeholder="TRK-000000"
                                      Valor="@_guia" ValorChanged="v => _guia = v" />
                            <AppButton Variante="info" Clase="w-100"
                                       OnClick="Enviar" Cargando="@_procesando">
                                <i class="bi bi-truck me-2"></i>Marcar como enviado
                            </AppButton>
                        }

                        @if (_pedido.Estado == "Enviado")
                        {
                            <AppButton Variante="success" Clase="w-100"
                                       OnClick="MarcarEntregado" Cargando="@_procesando">
                                <i class="bi bi-check2-circle me-2"></i>Marcar como entregado
                            </AppButton>
                        }

                        @if (_pedido.Estado is not ("Entregado" or "Cancelado"))
                        {
                            <AppButton Variante="outline-danger" Clase="w-100"
                                       OnClick="Cancelar" Cargando="@_procesando">
                                <i class="bi bi-x-circle me-2"></i>Cancelar pedido
                            </AppButton>
                        }

                        @if (_pedido.Estado is "Entregado" or "Cancelado")
                        {
                            <div class="text-center py-3">
                                <i class="bi @(_pedido.Estado == "Entregado" ? "bi-check-circle text-success" : "bi-x-circle text-danger") fs-3 d-block mb-2"></i>
                                <p class="small text-muted mb-0">
                                    @(_pedido.Estado == "Entregado" ? "Pedido entregado exitosamente." : "Este pedido fue cancelado.")
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long Id { get; set; }

    private PedidoResponse? _pedido;
    private bool _cargando = true;
    private bool _procesando;
    private string _guia = string.Empty;
    private string _error = string.Empty;
    private string _exito = string.Empty;

    private static readonly System.Globalization.CultureInfo _cultura = new("es-CO");

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        _cargando = true;
        try { _pedido = await Api.GetAsync<PedidoResponse>($"/api/pedidos/{Id}"); }
        catch { _pedido = null; }
        finally { _cargando = false; }
    }

    private async Task IniciarProcesamiento() => await CambiarEstado($"/api/pedidos/{Id}/procesar");
    private async Task MarcarEntregado()      => await CambiarEstado($"/api/pedidos/{Id}/entregar");
    private async Task Cancelar()             => await CambiarEstado($"/api/pedidos/{Id}/cancelar");

    private async Task Enviar()
    {
        if (string.IsNullOrWhiteSpace(_guia)) { _error = "Ingrese el número de guía."; return; }
        _error = string.Empty;
        _procesando = true;
        try
        {
            _pedido = await Api.PostAsync<PedidoResponse>($"/api/pedidos/{Id}/enviar",
                new EnviarPedidoRequest(_guia));
            _exito = "Estado actualizado.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _procesando = false; }
    }

    private async Task CambiarEstado(string url)
    {
        _error = _exito = string.Empty;
        _procesando = true;
        try
        {
            _pedido = await Api.PostAsync<PedidoResponse>(url);
            _exito = "Estado actualizado correctamente.";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _procesando = false; }
    }
}