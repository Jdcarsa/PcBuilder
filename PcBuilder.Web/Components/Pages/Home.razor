@page "/"


<PageTitle>PcBuilder — Arma tu PC Gamer</PageTitle>

<section class="hero-section bg-white border-bottom">
    <div class="container-xl py-5">
        <div class="hero-tag text-naranja small text-uppercase fw-semibold mb-3">
            <span class="hero-line me-2"></span>Tienda Gamer 2025
        </div>
        <h1 class="hero-title fw-light mb-3">
            <strong class="fw-black">Construye</strong> el equipo<br>que mereces.
        </h1>
        <p class="hero-sub text-muted mb-4">
            Componentes de alto rendimiento. Configura tu PC pieza<br>por pieza o explora el catálogo completo.
        </p>
        <div class="d-flex gap-3 flex-wrap">
            <a href="/armar" class="btn btn-naranja text-uppercase fw-bold letter-spacing-1 px-4">
                Armar mi PC
            </a>
            <a href="/catalogo" class="btn btn-outline-naranja text-uppercase fw-bold letter-spacing-1 px-4">
                Ver catálogo
            </a>
        </div>
    </div>
</section>

<section class="py-4 border-bottom bg-f8">
    <div class="container-xl">
        <p class="small text-uppercase text-muted letter-spacing-2 mb-3">Categorías destacadas</p>
        <div class="row row-cols-2 row-cols-md-4 g-1">
            @foreach (var cat in _categorias)
            {
                <div class="col">
                    <a href="/catalogo?categoria=@cat.Valor" class="categoria-tile d-flex align-items-center gap-2 p-3 bg-white border text-decoration-none">
                        <i class="bi @cat.Icono text-naranja fs-5"></i>
                        <div>
                            <div class="small fw-semibold text-dark">@cat.Nombre</div>
                            <div class="x-small text-muted">@cat.Desde</div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-5 bg-white">
    <div class="container-xl">
        <div class="strip-armar d-flex align-items-center justify-content-between flex-wrap gap-3 p-4 border">
            <div>
                <p class="small text-uppercase text-muted letter-spacing-2 mb-1">Compatibilidad garantizada</p>
                <h5 class="fw-bold mb-0">¿No sabes por dónde empezar?</h5>
                <p class="text-muted small mb-0">Nuestro armador te guía paso a paso.</p>
            </div>
            <a href="/armar" class="btn btn-naranja text-uppercase fw-bold letter-spacing-1">
                Empezar ahora →
            </a>
        </div>
    </div>
</section>

@code {
    private readonly List<CatInfo> _categorias =
    [
        new("Procesadores",    "bi-cpu",          "Desde $320.000",   "Procesador"),
        new("Tarjetas gráficas","bi-gpu-card",    "Desde $1.200.000", "TarjetaGrafica"),
        new("Placas madre",    "bi-motherboard",  "Desde $480.000",   "PlacaMadre"),
        new("Memorias RAM",    "bi-memory",       "Desde $180.000",   "MemoriaRam"),
        new("Almacenamiento",  "bi-device-hdd",   "Desde $150.000",   "Almacenamiento"),
        new("Fuentes de poder","bi-plug",         "Desde $200.000",   "FuentePoder"),
        new("Gabinetes",       "bi-pc-display",   "Desde $250.000",   "Gabinete"),
        new("Refrigeración",   "bi-thermometer",  "Desde $120.000",   "Refrigeracion"),
    ];

    private record CatInfo(string Nombre, string Icono, string Desde, string Valor);
}