@page "/componente/{Id:long}"
@rendermode InteractiveServer
@using PcBuilder.Application.DTOs
@using PcBuilder.Web.Components.Atoms
@using PcBuilder.Web.Services
@inject ApiClient Api
@inject CarritoService Carrito
@inject NavigationManager Nav

<PageTitle>Componente — PcBuilder</PageTitle>

<div class="container-xl py-4">
    <a href="/catalogo" class="btn btn-link btn-sm text-muted p-0 mb-3">
        <i class="bi bi-arrow-left me-1"></i>Volver al catálogo
    </a>

    @if (_cargando)
    {
        <Spinner />
    }
    else if (_componente is null)
    {
        <Alerta Mensaje="Componente no encontrado." Tipo="danger" />
    }
    else
    {
        <div class="row g-4 align-items-start">

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    @if (!string.IsNullOrWhiteSpace(_componente.UrlImagen))
                    {
                        <img src="@_componente.UrlImagen"
                             alt="@_componente.Nombre"
                             class="img-fluid mx-auto d-block"
                             style="max-height:320px;object-fit:contain;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center rounded-4 bg-light"
                             style="height:320px;font-size:5rem;color:#d0d0d0;">
                            <i class="bi bi-cpu"></i>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-7">
                <span class="badge rounded-pill px-3 py-1 bg-warning-subtle text-warning-emphasis fw-semibold mb-3 small">
                    @_componente.Categoria
                </span>

                <h2 class="fw-bold mb-1">@_componente.Nombre</h2>

                <p class="text-secondary small mb-3">
                    @_componente.Marca · @_componente.Modelo · SKU: @_componente.Sku
                </p>

                <p class="text-dark mb-4 lh-lg small">@_componente.Descripcion</p>

                @* Stats compactos *@
                <div class="d-flex gap-2 flex-wrap mb-4">
                    <div class="stat-chip">
                        <i class="bi bi-lightning-charge text-naranja me-1"></i>
                        <span class="fw-semibold">@_componente.ConsumoWatts W</span>
                        <span class="text-muted ms-1">consumo</span>
                    </div>
                    <div class="stat-chip @(_componente.TieneStock ? "stat-chip-ok" : "stat-chip-danger")">
                        <i class="bi @(_componente.TieneStock ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                        <span class="fw-semibold">
                            @(_componente.TieneStock ? $"{_componente.Stock} disponibles" : "Agotado")
                        </span>
                    </div>
                </div>

                @* Precio + acción *@
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                        <div>
                            <div class="x-small text-muted text-uppercase mb-1">Precio</div>
                            <div class="fs-3 fw-bold text-naranja">
                                @_componente.Precio.ToString("C0", _cultura)
                            </div>
                        </div>
                        @if (_componente.TieneStock)
                        {
                            <AppButton Variante="@(_enCarrito ? "outline-naranja" : "naranja")"
                                       OnClick="ToggleCarrito">
                                <i class="bi @(_enCarrito ? "bi-cart-check-fill" : "bi-cart-plus-fill") me-2"></i>
                                @(_enCarrito ? "En carrito" : "Agregar al carrito")
                            </AppButton>
                        }
                        else
                        {
                            <button class="btn btn-secondary" disabled>Sin stock</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public long Id { get; set; }

    private ComponenteResponse? _componente;
    private bool _cargando = true;
    private bool _enCarrito;

    private static readonly System.Globalization.CultureInfo _cultura = new("es-CO");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _componente = await Api.GetAsync<ComponenteResponse>($"/api/componentes/{Id}");
            if (_componente is not null)
                _enCarrito = Carrito.Contiene(_componente.Id);
        }
        catch { _componente = null; }
        finally { _cargando = false; }
    }

    private void ToggleCarrito()
    {
        if (_componente is null) return;
        if (_enCarrito) Carrito.Remover(_componente.Id);
        else Carrito.Agregar(_componente);
        _enCarrito = !_enCarrito;
    }
}