@page "/componente/{Id:long}"
@rendermode InteractiveServer
@using PcBuilder.Application.DTOs
@using PcBuilder.Web.Components.Atoms
@using PcBuilder.Web.Services
@inject ApiClient Api
@inject CarritoService Carrito
@inject NavigationManager Nav

<PageTitle>Componente — PcBuilder</PageTitle>

<div class="container-xl py-4">
    <a href="/catalogo" class="btn btn-link btn-sm text-muted p-0 mb-3">
        <i class="bi bi-arrow-left me-1"></i>Volver al catálogo
    </a>

    @if (_cargando)
    {
        <Spinner />
    }
    else if (_componente is null)
    {
        <Alerta Mensaje="Componente no encontrado." Tipo="danger" />
    }
    else
    {
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="card border-0 shadow-sm p-4">
                    @if (!string.IsNullOrWhiteSpace(_componente.UrlImagen))
                    {
                        <img src="@_componente.UrlImagen"
                             alt="@_componente.Nombre"
                             class="img-fluid"
                             style="max-height:280px;object-fit:contain" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center"
                             style="height:280px;color:#ddd;font-size:5rem">
                            <i class="bi bi-cpu"></i>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-8">
                <span class="badge bg-naranja-light text-naranja fw-semibold mb-2">
                    @_componente.Categoria
                </span>
                <h3 class="fw-black mb-1">@_componente.Nombre</h3>
                <p class="text-muted small mb-3">@_componente.Marca · @_componente.Modelo · SKU: @_componente.Sku</p>

                <p class="mb-4">@_componente.Descripcion</p>

                <div class="row g-2 mb-4">
                    <div class="col-6 col-md-4">
                        <div class="border rounded p-2 text-center">
                            <div class="small text-muted">Consumo</div>
                            <div class="fw-bold">@_componente.ConsumoWatts W</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4">
                        <div class="border rounded p-2 text-center">
                            <div class="small text-muted">Stock</div>
                            <div class="fw-bold @(_componente.TieneStock ? "text-success" : "text-danger")">
                                @(_componente.TieneStock ? $"{_componente.Stock} unid." : "Agotado")
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <span class="fs-3 fw-black text-naranja">
                        @_componente.Precio.ToString("C0", _cultura)
                    </span>
                    @if (_componente.TieneStock)
                    {
                        <AppButton Variante="@(_enCarrito ? "outline-naranja" : "naranja")"
                                   OnClick="ToggleCarrito">
                            <i class="bi @(_enCarrito ? "bi-cart-check" : "bi-cart-plus") me-2"></i>
                            @(_enCarrito ? "En carrito" : "Agregar al carrito")
                        </AppButton>
                    }
                    else
                    {
                        <button class="btn btn-secondary" disabled>Sin stock</button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public long Id { get; set; }

    private ComponenteResponse? _componente;
    private bool _cargando = true;
    private bool _enCarrito;

    private static readonly System.Globalization.CultureInfo _cultura = new("es-CO");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _componente = await Api.GetAsync<ComponenteResponse>($"/api/componentes/{Id}");
            if (_componente is not null)
                _enCarrito = Carrito.Contiene(_componente.Id);
        }
        catch { _componente = null; }
        finally { _cargando = false; }
    }

    private void ToggleCarrito()
    {
        if (_componente is null) return;

        if (_enCarrito)
            Carrito.Remover(_componente.Id);
        else
            Carrito.Agregar(_componente);

        _enCarrito = !_enCarrito;
    }
}
