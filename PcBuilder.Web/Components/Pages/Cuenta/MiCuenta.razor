@page "/cuenta/perfil"
@using PcBuilder.Application.DTOs
@using PcBuilder.Web.Components.Atoms
@using PcBuilder.Web.Services
@inject ApiClient Api
@inject SesionService Sesion
@inject NavigationManager Nav

<RedirectLogin ReturnUrl="/cuenta/perfil" />
<PageTitle>Mi Cuenta — PcBuilder</PageTitle>

<div class="container py-4" style="max-width:720px">

    <h4 class="fw-black text-uppercase mb-3">Mi cuenta</h4>

    <div class="card border-0 shadow-sm overflow-hidden">

        @* Header con avatar *@
        <div class="d-flex align-items-center gap-3 px-4 py-3 border-bottom">
            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                 style="width:52px;height:52px;background:#fff3e0;color:#bf5000;font-size:18px;flex-shrink:0;border:1px solid #ffd0a0">
                @Iniciales
            </div>
            <div>
                <p class="fw-semibold mb-0">@Sesion.Usuario?.NombreCompleto</p>
                <small class="text-muted">@Sesion.Usuario?.Email · @Sesion.Usuario?.Rol</small>
            </div>
        </div>

        @* Dos columnas *@
        <div class="row g-0">

            @* Datos personales *@
            <div class="col-md-6 border-end">
                <div class="p-4">
                    <p class="small fw-semibold text-uppercase text-muted letter-spacing-1 mb-3">
                        <i class="bi bi-person me-2 text-naranja"></i>Datos personales
                    </p>
                    <Alerta Mensaje="@_exitoPerfil" Tipo="success" />
                    <Alerta Mensaje="@_errorPerfil" Tipo="danger" />
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <AppInput Label="Nombre"
                                      Valor="@_nombre"
                                      ValorChanged="v => _nombre = v" />
                        </div>
                        <div class="col-6">
                            <AppInput Label="Apellido"
                                      Valor="@_apellido"
                                      ValorChanged="v => _apellido = v" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Email</label>
                        <input class="form-control form-control-sm bg-light"
                               value="@Sesion.Usuario?.Email" disabled />
                    </div>
                    <AppButton Variante="naranja" Tamaño="sm"
                               OnClick="GuardarPerfil" Cargando="@_guardandoPerfil">
                        <i class="bi bi-check2 me-1"></i>Guardar cambios
                    </AppButton>
                </div>
            </div>

            @* Cambiar contraseña *@
            <div class="col-md-6">
                <div class="p-4">
                    <p class="small fw-semibold text-uppercase text-muted letter-spacing-1 mb-3">
                        <i class="bi bi-lock me-2 text-naranja"></i>Cambiar contraseña
                    </p>
                    <Alerta Mensaje="@_exitoPassword" Tipo="success" />
                    <Alerta Mensaje="@_errorPassword" Tipo="danger" />
                    <AppInput Label="Contraseña actual" Type="password"
                              Placeholder="••••••••"
                              Valor="@_passwordActual"
                              ValorChanged="v => _passwordActual = v" />
                    <AppInput Label="Nueva contraseña" Type="password"
                              Placeholder="Mínimo 8 caracteres"
                              Valor="@_passwordNuevo"
                              ValorChanged="v => _passwordNuevo = v" />
                    <AppInput Label="Confirmar contraseña" Type="password"
                              Placeholder="Repetir contraseña"
                              Valor="@_passwordConfirm"
                              ValorChanged="v => _passwordConfirm = v" />
                    <AppButton Variante="naranja" Tamaño="sm"
                               OnClick="CambiarPassword" Cargando="@_guardandoPassword">
                        <i class="bi bi-key me-1"></i>Cambiar contraseña
                    </AppButton>
                </div>
            </div>
        </div>

        @* Footer de acciones *@
        <div class="d-flex align-items-center justify-content-between px-4 py-3 bg-light border-top">
            <a href="/cuenta/pedidos" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-box-seam me-1"></i>Mis pedidos
            </a>
            <button class="btn btn-outline-danger btn-sm" @onclick="CerrarSesion">
                <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión
            </button>
        </div>
    </div>
</div>

@code {
    private string _nombre = string.Empty;
    private string _apellido = string.Empty;
    private string _passwordActual = string.Empty;
    private string _passwordNuevo = string.Empty;
    private string _passwordConfirm = string.Empty;
    private bool _guardandoPerfil;
    private bool _guardandoPassword;
    private string _exitoPerfil = string.Empty;
    private string _errorPerfil = string.Empty;
    private string _exitoPassword = string.Empty;
    private string _errorPassword = string.Empty;

    private string Iniciales => $"{Sesion.Usuario?.Nombre?[0]}{Sesion.Usuario?.Apellido?[0]}".ToUpper();

    protected override void OnInitialized()
    {
        if (Sesion.Usuario is null) return;
        _nombre = Sesion.Usuario.Nombre;
        _apellido = Sesion.Usuario.Apellido;
    }

    private async Task GuardarPerfil()
    {
        _exitoPerfil = _errorPerfil = string.Empty;
        _guardandoPerfil = true;
        try
        {
            await Api.PutAsync<UsuarioResponse>("/api/usuarios/me",
                new ActualizarPerfilRequest(_nombre, _apellido));
            _exitoPerfil = "Perfil actualizado correctamente.";
        }
        catch (Exception ex) { _errorPerfil = ex.Message; }
        finally { _guardandoPerfil = false; }
    }

    private async Task CambiarPassword()
    {
        /*
        _exitoPassword = _errorPassword = string.Empty;

        if (_passwordNuevo != _passwordConfirm)
        {
            _errorPassword = "Las contraseñas no coinciden.";
            return;
        }

        _guardandoPassword = true;
        try
        {
            await Api.PatchAsync("/api/usuarios/me/password",
                new CambiarPasswordRequest(_passwordActual, _passwordNuevo));
            _exitoPassword = "Contraseña cambiada correctamente.";
            _passwordActual = _passwordNuevo = _passwordConfirm = string.Empty;
        }
        catch (Exception ex) { _errorPassword = ex.Message; }
        finally { _guardandoPassword = false; }}*/
    }

    private async Task CerrarSesion()
    {
        await Sesion.CerrarSesionAsync();
        Nav.NavigateTo("/");
    }
}