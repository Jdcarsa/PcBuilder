@* Atoms/AppButton.razor *@
<button class="@CssClass" @onclick="OnClick" disabled="@Disabled" type="@Type">
    @if (Cargando)
    {
        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
    }
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string Variante { get; set; } = "primary";
    [Parameter] public string Tamaño { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Cargando { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string Clase { get; set; } = "";

    private string CssClass => $"btn btn-{Variante} {(string.IsNullOrEmpty(Tamaño) ? "" : $"btn-{Tamaño}")} {Clase}".Trim();
}
