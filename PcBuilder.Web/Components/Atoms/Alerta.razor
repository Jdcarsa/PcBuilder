@* Atoms/Alerta.razor *@
@if (!string.IsNullOrWhiteSpace(Mensaje))
{
    <div class="alert alert-@Tipo alert-dismissible fade show" role="alert">
        <i class="bi @Icono me-2"></i>
        @Mensaje
        @if (Dismissible)
        {
            <button type="button" class="btn-close" @onclick="() => Mensaje = string.Empty"></button>
        }
    </div>
}

@code {
    [Parameter] public string Mensaje { get; set; } = string.Empty;
    [Parameter] public string Tipo { get; set; } = "danger";
    [Parameter] public bool Dismissible { get; set; } = true;

    private string Icono => Tipo switch
    {
        "success" => "bi-check-circle-fill",
        "warning" => "bi-exclamation-triangle-fill",
        "info"    => "bi-info-circle-fill",
        _         => "bi-x-circle-fill"
    };
}
