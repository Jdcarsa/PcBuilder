@* Organisms/NavBar.razor *@
@using PcBuilder.Web.Services
@inject CarritoService Carrito
@inject SesionService Sesion
@inject NavigationManager Nav
@implements IDisposable

<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top">
    <div class="container-xl">
        <a class="navbar-brand fw-bold text-uppercase letter-spacing-2" href="/">
            PC<span class="text-naranja">Builder</span>
        </a>

        <button class="navbar-toggler border-0" type="button"
                data-bs-toggle="collapse" data-bs-target="#navMenu">
            <i class="bi bi-list fs-4"></i>
        </button>

        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav mx-auto gap-1">
                <li class="nav-item">
                    <NavLink class="nav-link small fw-semibold px-3"
                             href="/" Match="NavLinkMatch.All">
                        Inicio
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link small fw-semibold px-3"
                             href="/catalogo">
                        Catálogo
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link small fw-semibold px-3"
                             href="/armar">
                        Armar PC
                    </NavLink>
                </li>
            </ul>

            <div class="d-flex align-items-center gap-2">
                <a href="/carrito" class="btn btn-outline-secondary btn-sm position-relative">
                    <i class="bi bi-cart3 fs-6"></i>
                    @if (Carrito.TotalItems > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-naranja">
                            @Carrito.TotalItems
                        </span>
                    }
                </a>

                @if (Sesion.EstaAutenticado)
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle"
                                data-bs-toggle="dropdown">
                            <i class="bi bi-person me-1"></i>
                            @Sesion.Usuario?.Nombre
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            @if (Sesion.EsAdministrador)
                            {
                                <li>
                                    <a class="dropdown-item" href="/admin">
                                        <i class="bi bi-grid-1x2 me-2"></i>Dashboard
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/admin/pedidos">
                                        <i class="bi bi-box-seam me-2"></i>Pedidos
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/admin/componentes">
                                        <i class="bi bi-cpu me-2"></i>Componentes
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="dropdown-item" href="/cuenta/pedidos">
                                        <i class="bi bi-box-seam me-2"></i>Mis pedidos
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/cuenta/perfil">
                                        <i class="bi bi-person-gear me-2"></i>Mi perfil
                                    </a>
                                </li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <button class="dropdown-item text-danger" @onclick="CerrarSesion">
                                    <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                                </button>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="/login" class="btn btn-naranja btn-sm">
                        <i class="bi bi-person me-1"></i>Ingresar
                    </a>
                }
            </div>
        </div>
    </div>
</nav>

@code {
    protected override void OnInitialized()
    {
        Carrito.OnChange += StateHasChanged;
        Sesion.OnChange += StateHasChanged;
    }

    private void CerrarSesion()
    {
        Sesion.CerrarSesion();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Carrito.OnChange -= StateHasChanged;
        Sesion.OnChange -= StateHasChanged;
    }
}
