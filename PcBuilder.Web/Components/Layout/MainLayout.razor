@inherits LayoutComponentBase
@using PcBuilder.Web.Components.Organisms
@using PcBuilder.Web.Services
@inject SesionService Sesion

<SesionInitializer OnInicializado="@(() => { _listo = true; StateHasChanged(); })" />

@if (_listo)
{
    <NavBar />
}
else
{
    <div style="height: 57px;" class="border-bottom bg-white shadow-sm sticky-top"></div>
}

<main class="main-content">
    @Body
</main>

<footer class="footer bg-white border-top mt-5 py-4">
    <div class="container-xl text-center">
        <p class="small text-muted mb-0">
            © 2025 <strong>PC<span class="text-naranja">Builder</span></strong>
            — Arma tu PC Gamer
        </p>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _listo;
}